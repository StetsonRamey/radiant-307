<!-- customer-tabs.webc -->
<section class="customer-tabs-section">
  <div class="container">
    <div class="tabs-content-container">
      <div class="tabs-title-container text-center">
        <h2 class="heading-2">Trusted by Homeowners and Businesses</h2>
        <p class="paragraph">
          See why Radiant 307 Plumbing is the go-to choice.
        </p>
      </div>
      <!-- Content for "Emergency" Tab (visible by default) -->
      <div class="tab-content-panel active">
        <div class="two-column-layout">
          <!-- Left Column -->
          <div class="column left-column">
            <h3 class="heading-3">Quick Response</h3>
            <p class="paragraph">If we don't answer when you call, leave me a message and I'll get right back to you.</p>
            <div class="button-container">
              <a :href="'tel:' + site.phone" class="btn" data-btn-variant="primary"
                >Call Now</a
              >
              <a href="/services/" class="btn" data-btn-variant="secondary" data-ghost-button>Check out our services</a>
            </div>
          </div>
          <!-- Right Column (Testimonial) -->
          <div class="column right-column">
            <div class="testimonial">
              <p class="testimonial-quote paragraph">Great service and great products, I am very satisfied</p>
              <div class="testimonial-attribution">
                <p class="attribution-name text-primary">Mike. T</p>
                <svg width="128" height="128" viewBox="0 0 128 128" xmlns="http://www.w3.org/2000/svg">
                  <path fill="#fff"
                    d="M44.59 4.21a63.28 63.28 0 0 0 4.33 120.9a67.6 67.6 0 0 0 32.36.35a57.13 57.13 0 0 0 25.9-13.46a57.44 57.44 0 0 0 16-26.26a74.3 74.3 0 0 0 1.61-33.58H65.27v24.69h34.47a29.72 29.72 0 0 1-12.66 19.52a36.2 36.2 0 0 1-13.93 5.5a41.3 41.3 0 0 1-15.1 0A37.2 37.2 0 0 1 44 95.74a39.3 39.3 0 0 1-14.5-19.42a38.3 38.3 0 0 1 0-24.63a39.25 39.25 0 0 1 9.18-14.91A37.17 37.17 0 0 1 76.13 27a34.3 34.3 0 0 1 13.64 8q5.83-5.8 11.64-11.63c2-2.09 4.18-4.08 6.15-6.22A61.2 61.2 0 0 0 87.2 4.59a64 64 0 0 0-42.61-.38" />
                  <path fill="#e33629"
                    d="M44.59 4.21a64 64 0 0 1 42.61.37a61.2 61.2 0 0 1 20.35 12.62c-2 2.14-4.11 4.14-6.15 6.22Q95.58 29.23 89.77 35a34.3 34.3 0 0 0-13.64-8a37.17 37.17 0 0 0-37.46 9.74a39.25 39.25 0 0 0-9.18 14.91L8.76 35.6A63.53 63.53 0 0 1 44.59 4.21" />
                  <path fill="#f8bd00"
                    d="M3.26 51.5a63 63 0 0 1 5.5-15.9l20.73 16.09a38.3 38.3 0 0 0 0 24.63q-10.36 8-20.73 16.08a63.33 63.33 0 0 1-5.5-40.9" />
                  <path fill="#587dbd"
                    d="M65.27 52.15h59.52a74.3 74.3 0 0 1-1.61 33.58a57.44 57.44 0 0 1-16 26.26c-6.69-5.22-13.41-10.4-20.1-15.62a29.72 29.72 0 0 0 12.66-19.54H65.27c-.01-8.22 0-16.45 0-24.68" />
                  <path fill="#319f43"
                    d="M8.75 92.4q10.37-8 20.73-16.08A39.3 39.3 0 0 0 44 95.74a37.2 37.2 0 0 0 14.08 6.08a41.3 41.3 0 0 0 15.1 0a36.2 36.2 0 0 0 13.93-5.5c6.69 5.22 13.41 10.4 20.1 15.62a57.13 57.13 0 0 1-25.9 13.47a67.6 67.6 0 0 1-32.36-.35a63 63 0 0 1-23-11.59A63.7 63.7 0 0 1 8.75 92.4" />
                </svg>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style webc:scoped>
  /* Basic Reset & Container */
  .customer-tabs-section * {
    box-sizing: border-box;
  }

  /* Section Styling */
  .customer-tabs-section {
    padding-block-start: 10rem;
    margin-block-end: -10rem;
    background-image: linear-gradient(
      to right,
    var(--color-primary-200),
      var(--color-primary-100)
    );
    color: var(--text-color);
    position: relative;
  }

  /* Titles */
  .tabs-title-container {
    margin-bottom: 2.5rem;
    text-align: center;
    margin-top: -3rem;
    padding: 1.5rem 1rem;
    border-radius: 0.5rem;
    position: relative;
    z-index: 1;
    background-color: var(--light-color);
  }

  /* Tab Content */
  .tabs-content-container {
    transform: translateY(-14rem);
    border-radius: 0.5rem;
    box-shadow: 0 4px 6px -1px var(--color-slate-600), 0 2px 4px -2px var(--color-slate-400);
    padding: 2rem;
    background-color: var(--light-color);
  }
  .tab-content-panel {
    display: none;
  }
  .tab-content-panel.active {
    display: block;
  }

  /* Two Column Layout */
  .two-column-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }
  @media (min-width: 768px) {
    .two-column-layout {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .column {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .left-column {
    gap: 1rem;
  }

  .left-column .button-container {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .link-arrow {
    margin-left: 0.25rem;
    display: inline-block;
  }

  /* Testimonial */
  .testimonial {
    background-color: rgba(255, 255, 255, 0.9);
    padding: 1.5rem;
    border-radius: 0.5rem;
    border: 1px solid var(--color-primary-600);
  }
  .testimonial-logo {
    height: 40px;
    width: auto;
    margin-bottom: 1rem;
    opacity: 0.8;
  }
  .testimonial-quote {
    font-size: 1.125rem;
    font-style: italic;
    margin-bottom: 1rem;
    border-left: 3px solid var(--color-secondary-500);
    padding-left: 1rem;
  }
  .testimonial-attribution {
    margin-top: 1.5rem;
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .testimonial-attribution svg {
    width: 20px;
    height: 20px;
    border-radius: 50%; /* Circular avatar */
    object-fit: cover;
  }

  .btn[data-ghost-button] {
    --button-bg: transparent;
    --button-border-color: var(--color-secondary-500);
    --button-hover-bg: transparent;
    --button-hover-color: var(--color-secondary-600);
  }

</style>
